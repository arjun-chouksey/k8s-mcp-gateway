.DS_Store

# Local environment values; explicitly safe templates remain versionable.
.env
.env.*
!.env.example
!.env.*.example
!.env.template
!.env.*.template

# Secret-bearing local configuration (do not put real values in templates).
/secrets/
/config/secrets/
*.secret.yaml
*.secret.yml
*.secrets.json
*.local.yaml
*.local.yml
*.local.json

# Private reference sources; never publish the assignment by accident.
/private-references/
/Urumi AI FDE Internship - Round 1_ MCP Gateway on Kubernetes.pdf

# Generated local development artifacts.
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
node_modules/
/web/dashboard/dist/
/tmp/

# Helm packages generated from local file dependencies; Chart.lock is versioned.
/charts/platform/charts/*.tgz

# Local engineering workflow and planning.
/AGENTS.md
/ROADMAP.md
/Makefile
/tickets/
/spikes/
/scripts/
/tests/

# Internal architecture and planning documents.
/docs/HLD.md
/docs/LLD.md
/docs/DECISIONS.md
/docs/DEMO.md
/docs/STATUS.md
